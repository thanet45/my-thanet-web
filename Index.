import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js';
import { getAuth, onAuthStateChanged, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-auth.js';
import { getFirestore, collection, doc, query, orderBy, onSnapshot, addDoc, updateDoc, deleteDoc, setDoc, getDoc, serverTimestamp, limit } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-firestore.js';
import { getStorage, ref, uploadBytes, getDownloadURL } from 'https://www.gstatic.com/firebasejs/11.10.0/firebase-storage.js';
import { firebaseConfig } from './firebase-config.js';
const $=id=>document.getElementById(id), app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app),storage=getStorage(app);
let user=null,isAdmin=false,profiles=[],unsubMessages=null,unsubRooms=null,unsubProfiles=null,activeRoom=null,activeProfile=null,rooms=[];
const toast=msg=>{const t=$('toast');t.textContent=msg;t.style.display='block';setTimeout(()=>t.style.display='none',4200)};
const fail=e=>{console.error(e);toast(e?.message||'เกิดข้อผิดพลาด กรุณาลองใหม่')};
const show=id=>$(id).showModal(),hide=id=>$(id).close();
const el=(tag,cls,text)=>{let n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n};
const appendButton=(parent,text,fn,cls='')=>{let b=el('button',cls,text);b.addEventListener('click',fn);parent.append(b);return b};
const safePhotos=p=>Array.isArray(p.photos)?p.photos.filter(s=>typeof s==='string'&&s.startsWith('https://')):[];
function renderProfiles(){let list=profiles.filter(p=>(p.number+' '+p.name).toLowerCase().includes($('search').value.toLowerCase()));$('cards').replaceChildren();if(!list.length){$('cards').append(el('p','muted','ยังไม่มีโปรไฟล์ที่ตรงกับการค้นหา'));return}list.forEach(p=>{let c=el('article','person'),cover=el('div','cover');const photos=safePhotos(p);if(photos.length){let im=el('img');im.src=photos[0];im.alt='รูปโปรไฟล์ '+p.name;im.loading='lazy';cover.append(im)}else cover.textContent='#'+p.number;let body=el('div','info');body.append(el('div',p.status==='online'?'status':'status offline',p.status==='online'?'● พร้อมคุย':'● ออฟไลน์'),el('h3','',`เบอร์ ${p.number} · ${p.name}`),el('p','muted',p.bio||'ดูรายละเอียดและเริ่มพูดคุย'));appendButton(body,'ดูรูปและพูดคุย',()=>openProfile(p),'gold');c.append(cover,body);$('cards').append(c)})}
function openProfile(p){activeProfile=p;const root=$('profileDetails');root.replaceChildren(el('h2','',`เบอร์ ${p.number} · ${p.name}`),el('p','muted',p.bio||'โปรไฟล์สมาชิก'));let g=el('div','gallery');safePhotos(p).forEach(url=>{let img=el('img');img.src=url;img.alt='ภาพโปรไฟล์';g.append(img)});if(!g.children.length)g.append(el('p','muted','ยังไม่มีภาพในแกลเลอรี'));root.append(g);appendButton(root,'เริ่มแชตกับผู้ดูแล',()=>{hide('profileDialog');startChat(p)},'gold');show('profileDialog')}
async function startChat(p){if(!user){show('authDialog');toast('กรุณาเข้าสู่ระบบก่อนเริ่มแชต');return}const id=user.uid+'_'+p.id;try{const roomRef=doc(db,'rooms',id);const snap=await getDoc(roomRef);if(!snap.exists())await setDoc(roomRef,{clientId:user.uid,profileId:p.id,profileName:p.name,profileNumber:p.number,createdAt:serverTimestamp(),updatedAt:serverTimestamp()});openChat(id,`เบอร์ ${p.number} · ${p.name}`)}catch(e){fail(e)}}
function openChat(roomId,title){if(unsubMessages)unsubMessages();activeRoom=roomId;$('chatTitle').textContent=title;$('messages').replaceChildren(el('p','muted','กำลังโหลดข้อความ...'));show('chatDialog');unsubMessages=onSnapshot(query(collection(db,'rooms',roomId,'messages'),orderBy('createdAt','asc'),limit(200)),snap=>{let box=$('messages');box.replaceChildren();snap.docs.forEach(d=>{let m=d.data(),mine=m.senderId===user?.uid,b=el('div','bubble'+(mine?' mine':''));b.append(el('div','',String(m.text||'')),el('small','',`${m.senderRole==='admin'?'ผู้ดูแล':'สมาชิก'} · ${m.createdAt?.toDate?.().toLocaleString('th-TH')||'กำลังส่ง'}`));box.append(b)});box.scrollTop=box.scrollHeight},fail)}
$('messageForm').addEventListener('submit',async e=>{e.preventDefault();if(!activeRoom||!user)return;let input=$('messageInput'),text=input.value.trim();if(!text||text.length>2000)return;input.disabled=true;try{await addDoc(collection(db,'rooms',activeRoom,'messages'),{text,senderId:user.uid,senderRole:isAdmin?'admin':'client',createdAt:serverTimestamp()});await updateDoc(doc(db,'rooms',activeRoom),{updatedAt:serverTimestamp()});input.value=''}catch(e){fail(e)}finally{input.disabled=false;input.focus()}});
$('closeChat').onclick=()=>hide('chatDialog');$('chatDialog').addEventListener('close',()=>{unsubMessages?.();unsubMessages=null;activeRoom=null});$('closeProfile').onclick=()=>hide('profileDialog');$('loginBtn').onclick=()=>show('authDialog');$('logoutBtn').onclick=()=>signOut(auth).catch(fail);$('search').oninput=renderProfiles;
async function doAuth(signup){$('authError').textContent='';let email=$('email').value.trim(),password=$('password').value;try{if(signup)await createUserWithEmailAndPassword(auth,email,password);else await signInWithEmailAndPassword(auth,email,password);hide('authDialog');$('password').value=''}catch(e){$('authError').textContent=e.message}}$('signinBtn').onclick=()=>doAuth(false);$('signupBtn').onclick=()=>doAuth(true);
onAuthStateChanged(auth,async u=>{unsubMessages?.();unsubMessages=null;activeRoom=null;if($('chatDialog').open)hide('chatDialog');user=u;isAdmin=false;$('identity').textContent=u?.email||'ผู้เยี่ยมชม';$('loginBtn').hidden=!!u;$('logoutBtn').hidden=!u;if(u){try{let role=await getDoc(doc(db,'admins',u.uid));isAdmin=role.exists()}catch(e){console.error(e)}}$('adminBtn').hidden=!isAdmin;unsubRooms?.();unsubRooms=null;if(isAdmin)subscribeRooms();if($('adminDialog').open&&!isAdmin)hide('adminDialog')});
unsubProfiles=onSnapshot(query(collection(db,'profiles'),orderBy('number')),snap=>{profiles=snap.docs.map(d=>({id:d.id,...d.data()}));renderProfiles();if(isAdmin)renderAdminProfiles()},fail);
$('adminBtn').onclick=()=>{renderAdminProfiles();renderInbox();show('adminDialog')};$('closeAdmin').onclick=()=>hide('adminDialog');$('tabProfiles').onclick=()=>{$('profileAdmin').hidden=false;$('inboxAdmin').hidden=true;$('tabProfiles').classList.add('selected');$('tabInbox').classList.remove('selected')};$('tabInbox').onclick=()=>{$('profileAdmin').hidden=true;$('inboxAdmin').hidden=false;$('tabInbox').classList.add('selected');$('tabProfiles').classList.remove('selected')};
function renderAdminProfiles(){const root=$('adminProfiles');root.replaceChildren();profiles.forEach(p=>{let r=el('div','adminrow');r.append(el('span','',`#${p.number} · ${p.name} (${safePhotos(p).length} รูป)`));let btns=el('div','actions');appendButton(btns,'แก้ไข',()=>{ $('editId').value=p.id;$('pNumber').value=p.number;$('pName').value=p.name;$('pBio').value=p.bio||'';$('pStatus').value=p.status||'online';$('pImages').value='';$('uploadInfo').textContent='ภาพใหม่จะเพิ่มต่อท้ายภาพเดิม';$('profileForm').scrollIntoView({behavior:'smooth'})});appendButton(btns,'ลบ',async()=>{if(!confirm(`ลบโปรไฟล์ #${p.number}? รูปเดิมบน Storage และห้องแชตจะไม่ถูกลบอัตโนมัติ`))return;try{await deleteDoc(doc(db,'profiles',p.id))}catch(e){fail(e)}});r.append(btns);root.append(r)})}
$('resetProfile').onclick=()=>{$('profileForm').reset();$('editId').value='';$('uploadInfo').textContent=''};
$('profileForm').onsubmit=async e=>{e.preventDefault();if(!isAdmin)return;let b=$('saveProfile');b.disabled=true;try{let id=$('editId').value||doc(collection(db,'profiles')).id,existing=profiles.find(p=>p.id===id),images=[...$('pImages').files];if(images.length>12)throw Error('อัปโหลดได้ครั้งละไม่เกิน 12 รูป');let photos=safePhotos(existing||{});for(let i=0;i<images.length;i++){let f=images[i];if(!['image/jpeg','image/png','image/webp'].includes(f.type)||f.size>10*1024*1024)throw Error('รองรับ JPEG/PNG/WebP ขนาดไม่เกิน 10MB');$('uploadInfo').textContent=`กำลังอัปโหลด ${i+1}/${images.length}`;let path=`profiles/${id}/${crypto.randomUUID()}-${f.name.replace(/[^a-zA-Z0-9._-]/g,'_')}`;let obj=ref(storage,path);await uploadBytes(obj,f,{contentType:f.type});photos.push(await getDownloadURL(obj))}await setDoc(doc(db,'profiles',id),{number:$('pNumber').value.trim(),name:$('pName').value.trim(),bio:$('pBio').value.trim(),status:$('pStatus').value,photos,updatedAt:serverTimestamp()});$('resetProfile').click();toast('บันทึกโปรไฟล์สำเร็จ')}catch(e){fail(e)}finally{b.disabled=false}};
function subscribeRooms(){unsubRooms=onSnapshot(query(collection(db,'rooms'),orderBy('updatedAt','desc'),limit(100)),snap=>{rooms=snap.docs.map(d=>({id:d.id,...d.data()}));renderInbox()},fail)}
function renderInbox(){const root=$('inbox');root.replaceChildren();if(!rooms.length)root.append(el('p','muted','ยังไม่มีการสนทนา'));rooms.forEach(room=>{let r=el('div','inboxrow');r.append(el('span','',`#${room.profileNumber||'?'} · ${room.profileName||''} | สมาชิก ${room.clientId.slice(0,8)}…`));appendButton(r,'เปิดแชต',()=>{hide('adminDialog');openChat(room.id,`แชตเบอร์ ${room.profileNumber} · สมาชิก ${room.clientId.slice(0,8)}`)},'gold');root.append(r)})}


